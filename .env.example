# Leave empty to use the local Vite /api proxy. Production URLs must include the /api prefix.
VITE_API_BASE_URL=

# Backend settings. Leave empty to use server/farmlink.db locally.
# PostgreSQL example: postgresql+psycopg://farmlink_app:replace-me@127.0.0.1:5432/farmlink
FARMLINK_DATABASE_URL=
FARMLINK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FARMLINK_HOST=127.0.0.1
PORT=5000

# Browser-restricted key with Maps JavaScript API and Directions API enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Advanced Markers requires a Google Maps map ID; DEMO_MAP_ID is used when omitted.
VITE_GOOGLE_MAPS_MAP_ID=

# Server-only key: enable Google Geocoding API and Directions API. Do not use
# the browser-restricted VITE key here; this key must never be exposed to Vite.
GOOGLE_MAPS_SERVER_API_KEY=

FARMLINK_GEOCODE_REGION=in

# Alternative server-only provider. Enable Geoapify Geocoding and Routing APIs.
GEOAPIFY_API_KEY=
